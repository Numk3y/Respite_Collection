[resource]
script = ExtResource("1")
id = &"private_party"
title = "Private Party"
text = "A VIP waves you over to a roped-off room. \"Prove you belong in here.\""
choices = Array[Dictionary]([{"text": "Go in", "result": "The VIP's crew blocks the door.", "effects": {"fight": "elite"}}, {"text": "Take the cover charge back", "result": "They pay you to leave. Fine by you.", "effects": {"tips": 25}}])
min_night = 1
