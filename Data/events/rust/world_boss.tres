[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"rust_world_boss_passive"
display_name = "Full Metal Kit"
description = "Takes 25% less damage from every hit, and his shots can reach anyone, back row included: only a taunting tank can pull his fire. Every turn he gets angrier: +10% Attack per action, compounding. Matches your team's level."
effect_id = &"full_metal_kit"
params = {"damage_reduction": 0.25, "enrage": 0.1}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"rust_world_boss_active"
display_name = "Full Auto"
kind = 1
description = "Empties a whole AK mag: 6 shots sprayed across both rows for 70% of his Attack each. A taunting tank takes every shot."
effect_id = &"full_auto"
params = {"any_row": true, "damage_mult": 0.7, "shots": 6}

[resource]
script = ExtResource("1")
