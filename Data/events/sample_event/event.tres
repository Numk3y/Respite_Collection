[sub_resource type="Resource" id="reward_all"]
script = ExtResource("3")
money = 1000
credit_cards = 3
materials = Dictionary[String, int]({"gossip": 3})

[sub_resource type="Resource" id="reward_1st"]
script = ExtResource("3")
money = 3000
