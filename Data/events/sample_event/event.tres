[resource]
script = ExtResource("1")
id = &"sample_event"
display_name = "Night Market Bash"
description = "The night market is open all night, and Uncle Bourbon has had far too much. Fight through the stalls, then team up with every player to bring down the Giant Uncle Bourbon."
missions = Array[ExtResource("2")]([ExtResource("11"), ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("21"), ExtResource("22"), ExtResource("23"), ExtResource("24")])
boss_stage = ExtResource("30")
boss_hp = 1000000
hours = 72.0
attempts_per_day = 5
actions_per_fight = 40
reward_all = SubResource("reward_all")
reward_top = Array[ExtResource("3")]([SubResource("reward_1st"), SubResource("reward_2nd"), SubResource("reward_3rd")])
