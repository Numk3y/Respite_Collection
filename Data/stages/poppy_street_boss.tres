[resource]
script = ExtResource("1")
id = &"poppy_street_boss"
display_name = "Poppy Street"
description = "Last call on Poppy Street. Fight through the whole street's worth of drunks to reach Uncle Bourbon, the man who never stops drinking. The drunker he gets, the harder he hits."
chapter = 1
number = 5
recommended_level = 6
enemy_level = 5
waves = Array[ExtResource("4")]([SubResource("wave_1"), SubResource("wave_2"), SubResource("wave_3"), SubResource("wave_4")])
reward_money = 200
exp_reward = 60
reward_materials = Dictionary[String, Vector2i]({"coffee": Vector2i(2, 3), "gossip": Vector2i(1, 2), "snack": Vector2i(3, 6)})
equipment_drops = Array[ExtResource("3")]([ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("15")])
drop_chance = 0.15
