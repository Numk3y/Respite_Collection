[resource]
script = ExtResource("1")
id = &"drinking_night_group_instance"
display_name = "Drinking Night Group Instance"
description = "The private group instance where the real party happens. The Instance Owner hides behind a full room: the more of his crowd still standing, the tougher he is, and he kicks anyone who gets too strong."
chapter = 2
number = 5
recommended_level = 12
enemy_level = 7
waves = Array[ExtResource("4")]([SubResource("wave_1"), SubResource("wave_2"), SubResource("wave_3"), SubResource("wave_4")])
reward_money = 350
exp_reward = 100
reward_materials = Dictionary[String, Vector2i]({"coffee": Vector2i(2, 4), "gossip": Vector2i(1, 3), "snack": Vector2i(4, 7)})
equipment_drops = Array[ExtResource("3")]([ExtResource("14"), ExtResource("15"), ExtResource("16"), ExtResource("17"), ExtResource("18"), ExtResource("19")])
drop_chance = 0.18
