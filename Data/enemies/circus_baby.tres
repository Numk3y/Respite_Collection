[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"circus_baby_passive"
display_name = "Bidybab Backup"
description = "Never attacks herself. Whenever someone damages her, one of her back-row helpers instantly hits back for 70% of their Attack."
effect_id = &"one_above_all"
params = {"attack_mult": 0.7}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"circus_baby_active"
display_name = "Get Back to Work!"
kind = 1
description = "The ringmaster's whip: 5 lashes at random front-row enemies for 60% of her Attack each, each one healing her 3% of her max HP."
effect_id = &"whip_crack"
params = {"damage_mult": 0.6, "heal_pct": 0.03, "lashes": 5}

