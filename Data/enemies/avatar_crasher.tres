[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"avatar_crasher_passive"
display_name = "Particle Spam"
description = "Each hit has a 20% chance to fill the target's screen with particles: -50% Accuracy for its next turn."
effect_id = &"blinding"
params = {"accuracy": -0.5, "chance": 0.2, "turns": 1}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"avatar_crasher_active"
display_name = "Crash Everyone"
kind = 1
description = "Switches into the crasher avatar: hits every enemy for 80% of his Attack and wipes all their buffs."
effect_id = &"close_instance"
params = {"damage_mult": 0.8}

[resource]
