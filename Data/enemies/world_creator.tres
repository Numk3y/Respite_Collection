[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://Scripts/resources/character_data.gd" id="1"]
[ext_resource type="Script" path="res://Scripts/resources/skill_data.gd" id="2"]

[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"world_creator_passive"
display_name = "Kill Brick"
description = "Every hit Wounds: the target gets 60% less healing for 2 turns. He built the floor to hurt."
effect_id = &"wounding"
params = {"chance": 1.0, "heal_cut": 0.6, "turns": 2}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"world_creator_active"
display_name = "Pen Spam"
kind = 1
description = "Spawns a wall of pens and throws them: 4 shots at random front-row enemies for 75% of his Attack each."
effect_id = &"full_auto"
params = {"any_row": false, "damage_mult": 0.75, "shots": 4}

[resource]
script = ExtResource("1")
id = &"world_creator"
display_name = "World Creator"
char_class = 3
rarity = 1
hp = 115
attack = 96
defense = 26
evasion = 26
accuracy = 98
speed = 62
passive_skill = SubResource("passive")
active_skill = SubResource("active")
ultimate_max = 100
portrait_path = "res://Art/enemies/world_creator.png"
description = "Built half the worlds you've visited and knows every exploit in them. Has been 'fixing one bug' since 9 PM."
