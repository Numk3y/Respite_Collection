params = {"lifesteal": 0.25}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"night_owl_active"
display_name = "Midnight Moon"
kind = 1
description = "Shoots the moon itself at one enemy for 140% of his Attack; shards splash onto 2 more for 60%, then he snipes the first one again for 80%."
effect_id = &"moonlight_vigil"
params = {"damage_mult": 1.4, "snipe_mult": 0.8, "splash": 0.6, "splash_targets": 2}

[resource]
