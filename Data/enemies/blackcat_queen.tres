[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"blackcat_queen_passive"
display_name = "Main Character Energy"
description = "+12% Defense for every other enemy still standing. Every 3 turns, vote-kicks your strongest attacker: they skip their next turn rejoining."
effect_id = &"group_owner"
params = {"defense_per_ally": 0.12, "kick_every": 3, "kick_turns": 1}

[sub_resource type="Resource" id="active"]
