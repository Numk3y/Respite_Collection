kind = 1
description = "Nothing is real, so nothing matters: every ally deals +20% damage and gets +10% Speed for 3 turns."
effect_id = &"morale_booster"
params = {"bleed_bonus": 0.0, "damage": 0.2, "speed": 0.1, "turns": 3}

