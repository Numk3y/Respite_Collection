[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"dollar_mic_kid_passive"
display_name = "SHUT UP I'M WINNING"
description = "Surviving a hit has a 40% chance to scream at the attacker: they get -25% Attack and Defense for 2 turns, and he gets +15% Speed for his next turn."
effect_id = &"its_raw"
params = {"attack": -0.25, "chance": 0.4, "defense": -0.25, "speed": 0.15, "speed_turns": 1, "turns": 2}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"dollar_mic_kid_active"
display_name = "SPEAKER ON"
kind = 1
description = "Screams into the Dollar Mic with the speaker on: hits every enemy for 80% of his Attack and Deafens them (-30% Accuracy, -20% Speed for 2 turns)."
effect_id = &"speaker_on"
params = {"accuracy": -0.3, "damage_mult": 0.8, "speed": -0.2, "turns": 2}

[resource]
script = ExtResource("1")
id = &"dollar_mic_kid"
