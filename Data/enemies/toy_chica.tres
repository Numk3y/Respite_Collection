[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"toy_chica_passive"
display_name = "Cupcake Snacks"
description = "While she's standing, her front row heals a little at the end of every one of her turns. Her cupcake does the rest."
effect_id = &"chilling"
params = {"regen_pct": 0.15}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"toy_chica_active"
display_name = "Party Time"
kind = 1
description = "Gets the party going: every ally gets +25% Defense and +10% Speed for 3 turns, and heals 10% of the HP they're missing each turn."
effect_id = &"bird_up"
params = {"defense": 0.25, "regen_lost": 0.1, "speed": 0.1, "turns": 3}

