[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"frenni_passive"
display_name = "The Show Must Go On"
description = "Once per battle, a lethal hit leaves her at 1 HP. She keeps performing for 3 more turns before the curtain falls."
effect_id = &"undying"
params = {"turns": 3}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
