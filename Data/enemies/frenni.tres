display_name = "Encore!"
kind = 1
description = "Calls the whole club back on stage: every ally deals +25% damage and gets +15% Speed for 3 turns."
effect_id = &"morale_booster"
params = {"bleed_bonus": 0.0, "damage": 0.25, "speed": 0.15, "turns": 3}

