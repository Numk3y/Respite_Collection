[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"dreamy_passive"
display_name = "Brotschneidemaschine"
description = "Every time a teammate acts, Dreamy feeds them bread, healing them for 8% of Dreamy's Attack. When Dreamy attacks, he feeds the enemy poison bread for 60% damage, and 20% of the damage dealt heals the teammate lowest on HP."
effect_id = &"brotschneidemaschine"
params = {"heal_mult": 0.08, "damage_mult": 0.6, "lifesteal": 0.2}

