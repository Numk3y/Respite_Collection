[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"lag_passive"
display_name = "Nimble Body"
description = "Lag has a 30% chance to evade any attack. Every time he attacks, he gains +10% Speed (up to +30%). The boost is lost the moment an enemy lands a hit on him."
