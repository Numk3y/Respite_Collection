[ext_resource type="Script" path="res://Scripts/resources/skill_data.gd" id="2"]

[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"quinnester_passive"
display_name = "Until Next Time"
description = "When Quinn takes down an enemy: -30% Speed and +65% damage for his next 3 turns, and every shot that lands splashes onto another enemy for 50% of the damage. 5-turn cooldown from the takedown."
effect_id = &"until_next_time"
params = {"speed": -0.3, "damage": 0.65, "splash": 0.5, "turns": 3, "cooldown": 5}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"quinnester_active"
display_name = "Hat Trick"
kind = 1
description = "Locks onto an enemy and shoots it. For his next 3 turns every shot goes to that enemy, and each hit leaves a Hat. At 3 Hats they explode for 30% of the enemy's max HP (ignores Defense, at most 300% of Quinn's Attack)."
effect_id = &"hat_trick"
params = {"damage_mult": 1.0, "turns": 3, "marks": 3, "explode_pct": 0.3, "cap_mult": 3.0}

[resource]
script = ExtResource("1")
