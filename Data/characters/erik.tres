[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"erik_passive"
display_name = "Testicular Torsion"
description = "As a powerful mage, Erik casts Testicular Torsion with every hit: the enemy loses 15% of its Ultimate gauge and gets -10% Speed for 2 turns."
effect_id = &"testicular_torsion"
params = {"gauge": 0.15, "speed": -0.1, "turns": 2}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"erik_active"
display_name = "Try Finger But Hole"
kind = 1
description = "Erik casts the magic he learned from the Shadow Wizard Money Gang and fingers the whole enemy front row: 100% of his Attack to each, with a 60% chance to Stun each one for a turn."
effect_id = &"try_finger_but_hole"
params = {"damage_mult": 1.0, "stun_chance": 0.6, "stun_turns": 1}

