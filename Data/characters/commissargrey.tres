[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"commissargrey_passive"
display_name = "Background NPC"
description = "Nobody notices CommissarGrey: enemies can't target him at all until one of his back-row teammates falls. He never attacks; each turn he heals the teammate who needs it most for 40% of his Attack."
effect_id = &"background_npc"
params = {"heal_mult": 0.4, "targets": 1}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"commissargrey_active"
display_name = "BirdUP!"
kind = 1
description = "Buffs the whole party for 3 turns: +30% Defense, +10% Speed, and each turn they heal 10% of the HP they're missing."
effect_id = &"bird_up"
params = {"defense": 0.3, "regen_lost": 0.1, "speed": 0.1, "turns": 3}

