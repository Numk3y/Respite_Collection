[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"gobby_passive"
display_name = "Thick Skin"
description = "When a hit drops Gobby below 20% HP, he heals back up to 50% and gains Defense +20% for 3 turns. Cooldown: 10 turns."
effect_id = &"second_wind"
params = {"cooldown": 10, "defense": 0.2, "heal_to": 0.5, "threshold": 0.2, "turns": 3}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"gobby_active"
display_name = "Guardian"
kind = 1
description = "Raises Gobby's Defense by 50% and taunts: enemies' single-target attacks must hit Gobby. Lasts 3 of Gobby's actions."
effect_id = &"guardian"
params = {"defense": 0.5, "turns": 3}

