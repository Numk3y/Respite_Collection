[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://Scripts/resources/character_data.gd" id="1"]
[ext_resource type="Script" path="res://Scripts/resources/skill_data.gd" id="2"]

[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"storm_passive"
display_name = "Eye of the Storm"
description = "Every attack Storm lands has a 40% chance to splash onto a random enemy in the back row for 20% of the damage."
effect_id = &"eye_of_the_storm"
params = {"chance": 0.4, "splash": 0.2}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"storm_active"
display_name = "Light Assault"
kind = 1
description = "Rapid-fires 5 arrows, each at a random enemy for 45% of Storm's Attack. Every arrow counts as an attack for Eye of the Storm."
effect_id = &"light_assault"
params = {"shots": 5, "damage_mult": 0.45}

[resource]
script = ExtResource("1")
id = &"storm"
display_name = "Storm"
char_class = 3
rarity = 2
hp = 80
attack = 75
defense = 35
evasion = 15
accuracy = 95
speed = 50
passive_skill = SubResource("passive")
active_skill = SubResource("active")
ultimate_max = 130
description = "A marksman who fights inside the gale. Storm's arrows never fly alone."
is_starter = false
