[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"roki_active"
display_name = "Umamusume"
kind = 1
description = "Roki turns into a horse for 5 turns. Each turn as a horse costs 5% of max HP (never the last 1 HP) and adds +10% Speed, stacking. While Roki is a horse, back-row Marksmen get +30% Speed, and Roki's Ultimate gauge stays empty."
effect_id = &"umamusume"
params = {"turns": 5, "drain_pct": 0.05, "speed_per_turn": 0.1, "ally_speed": 0.3}

