[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://Scripts/resources/character_data.gd" id="1"]
[ext_resource type="Script" path="res://Scripts/resources/skill_data.gd" id="2"]

[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"goodname_passive"
display_name = "Pool Addiction"
description = "Every attack Goodname lands splashes onto a random enemy in the back row for 20% of the damage."
effect_id = &"pool_addiction"
params = {"splash": 0.2}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"goodname_active"
display_name = "Solid Goodname"
kind = 1
description = "Bro turns into Snake from Metal Gear Solid for 3 turns: +200% Attack but -50% Speed. While he's Snake, enemies usually can't find him: 70% of single-target attacks aimed at him hit another front-row ally instead."
effect_id = &"snake_mode"
params = {"attack": 2.0, "dodge_chance": 0.7, "speed": -0.5, "turns": 3}

[resource]
script = ExtResource("1")
id = &"goodname"
display_name = "Goodname"
char_class = 1
rarity = 2
hp = 120
attack = 85
defense = 55
evasion = 25
accuracy = 75
speed = 65
portrait_path = "res://Art/characters/Goodname.png"
cutin_path = "res://Art/cutins/Goodname.png"
passive_skill = SubResource("passive")
active_skill = SubResource("active")
