[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"keizoyama_passive"
display_name = "Infinite Backshot"
description = "Yama takes every hit as a backshot. Every enemy hit on him heals him 4% of his max HP (3% if the hit comes from the enemy back row)."
effect_id = &"infinite_backshot"
params = {"heal_pct": 0.04, "back_row_heal_pct": 0.03}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"keizoyama_active"
display_name = "I LOVE GYATT"
kind = 1
description = "For 2 turns, Yama taunts the enemy back row, and every attack that hits him has a 35% chance to be deflected onto a random enemy front-row unit for 150% damage."
effect_id = &"i_love_gyatt"
params = {"turns": 2, "deflect_chance": 0.35, "deflect_mult": 1.5}

