[sub_resource type="Resource" id="passive"]
script = ExtResource("2")
id = &"noel_passive"
display_name = "Capybara !"
description = "Noel's pet Capybara Marks a random enemy. Until it falls, Noel only attacks the Marked enemy and deals 25% more damage to it. When the Marked enemy falls, the Capybara hits a random enemy for 15% of the fallen one's max HP, and the Mark moves to another enemy."
effect_id = &"capybara"
params = {"damage_mult": 1.0, "mark_bonus": 0.25, "splash_pct": 0.15}

[sub_resource type="Resource" id="active"]
script = ExtResource("2")
id = &"noel_active"
display_name = "I AM ATOMIC"
kind = 1
description = "Noel begins a long cast and stays idle on the next turn. On the turn after that, Noel deals 300% damage to the whole enemy team."
effect_id = &"i_am_atomic"
params = {"charge_turns": 1, "damage_mult": 3.0}

