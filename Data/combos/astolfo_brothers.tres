[gd_resource type="Resource" script_class="ComboData" format=3]

[ext_resource type="Script" path="res://Scripts/resources/combo_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"astolfo_brothers"
display_name = "Astolfo Brothers"
description = "Spijette and Gobby each strike twice, and each one heals the other for all the damage they dealt."
members = Array[StringName]([&"spijette", &"gobby"])
effect_id = &"astolfo_brothers"
params = {"hits": 2, "hit_mult": 1.0}
